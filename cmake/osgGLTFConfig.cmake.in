@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(OpenSceneGraph REQUIRED COMPONENTS
	osg
	osgDB
	osgViewer
	osgGA
	osgUtil
)

include("${CMAKE_CURRENT_LIST_DIR}/osgGLTFTargets.cmake")

# CMake's FindOpenSceneGraph module does not provide imported targets. Attach the include and
# library results to the installed target without exporting build-machine absolute paths.
set_property(TARGET osgGLTF::osgGLTF APPEND PROPERTY
	INTERFACE_INCLUDE_DIRECTORIES "${OPENSCENEGRAPH_INCLUDE_DIRS}"
)
set_property(TARGET osgGLTF::osgGLTF APPEND PROPERTY
	INTERFACE_LINK_LIBRARIES "${OPENSCENEGRAPH_LIBRARIES}"
)

check_required_components(osgGLTF)
